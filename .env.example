# ZPQ Environment Variables Template
# Copy this to '.env' in the project root and fill in your details.
# The '.env' file is local-only and ignored by git.

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-west-2
# AWS_SESSION_TOKEN=optional_token

# --- S3 Test Data ---
# Bucket used by every benchmarks/run_*.sh script. They read input
# fixtures from `s3://${AWS_S3_BUCKET}/zpq_test_data/...` and write
# outputs under `s3://${AWS_S3_BUCKET}/bench/...`. The deployed
# zpq-filter-s3 Lambda must have read+write access to this bucket
# (granted via the function's execution role, NOT this key).
AWS_S3_BUCKET=your-bench-bucket

# Used by probes and benchmarks/run.sh as a fully-qualified path
# (overrides AWS_S3_BUCKET-based defaults for one-off invocations).
ZPQ_TEST_S3_PATH=s3://your-bucket/path/to/data.parquet

# --- Lambda Deploy ---
# IAM role ARN used when `aws.sh deploy` creates a new function.
# When updating an existing function, the role is preserved unchanged.
# If unset, the deploy script tries to inherit from `zpq-filter-s3`
# (assumes you've already deployed that one manually with a role).
# ZPQ_LAMBDA_ROLE=arn:aws:iam::123456789012:role/zpq-lambda-role

# --- GitHub Integration ---
# Used by just fetch-deps to pull pre-built binaries
GH_OWNER=chicagobuss
GH_REPO=zpq
DEPS_TAG=deps-v0.1

# --- Cloudflare R2 (Artifact Storage) ---
# Used for storing/fetching pre-built BoringSSL artifacts
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=zpq
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- Remote Benchmarking ---
# SSH host alias for remote benchmarks
BENCH_HOST=your-remote-host
BENCH_REMOTE_DIR=~/code/zpq-work
