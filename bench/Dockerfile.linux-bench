FROM debian:bookworm-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl xz-utils jq ca-certificates \
    python3 python3-pip python3-venv \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Fetch Zig (uses master since dev builds are ephemeral)
# Note: .zig-version pins 0.16.0-dev.1634+b27bdd5af but old dev builds are removed
ARG TARGETARCH
RUN ARCH=$([ "$TARGETARCH" = "arm64" ] && echo "aarch64" || echo "x86_64") && \
    ZIG_URL=$(curl -s https://ziglang.org/download/index.json | jq -r ".master.\"${ARCH}-linux\".tarball") && \
    echo "Downloading: $ZIG_URL" && \
    curl -fsSL "$ZIG_URL" -o zig.tar.xz && \
    mkdir -p /usr/local/zig && \
    tar -xf zig.tar.xz -C /usr/local/zig --strip-components=1 && \
    rm zig.tar.xz
ENV PATH="/usr/local/zig:${PATH}"

WORKDIR /app

# Copy project files
COPY . .

# Build all (includes benchmark binaries)
RUN zig build -Doptimize=ReleaseFast

# Default command: list benchmarks
CMD ["./benchmarks/bench.sh", "list"]
