#!/usr/bin/env bpftrace
/*
 * trace_io_uring.bt - Trace io_uring and TCP for shootout analysis
 */

BEGIN {
    printf("Tracing io_uring + TCP for shootout-tls... Ctrl+C to stop\n");
}

/* io_uring submit */
tracepoint:io_uring:io_uring_submit_req
/comm == "shootout-tls"/
{
    @submit_count = count();
    @submit_by_op[args->opcode] = count();
}

/* io_uring complete */
tracepoint:io_uring:io_uring_complete
/comm == "shootout-tls"/
{
    @complete_count = count();
    if (args->res > 0) {
        @complete_res_hist = lhist(args->res, 0, 100000, 1000);
    }
}

/* TCP receive - kernel level */
kprobe:tcp_recvmsg
/comm == "shootout-tls"/
{
    @tcp_recv_start[tid] = nsecs;
}

kretprobe:tcp_recvmsg
/comm == "shootout-tls" && @tcp_recv_start[tid]/
{
    $lat_us = (nsecs - @tcp_recv_start[tid]) / 1000;
    $bytes = retval;

    if ($bytes > 0) {
        @tcp_bytes_hist = lhist($bytes, 0, 65536, 4096);
        @tcp_lat_us = lhist($lat_us, 0, 100000, 1000);
        @tcp_total_bytes = @tcp_total_bytes + $bytes;
        @tcp_recv_count = @tcp_recv_count + 1;
    }
    delete(@tcp_recv_start[tid]);
}

/* TCP send - kernel level */
kprobe:tcp_sendmsg
/comm == "shootout-tls"/
{
    @tcp_send_count = count();
}

END {
    printf("\n=== io_uring Summary ===\n");
    printf("Submits: "); print(@submit_count);
    printf("Completes: "); print(@complete_count);
    printf("\nSubmits by opcode:\n"); print(@submit_by_op);
    printf("\nComplete result sizes:\n"); print(@complete_res_hist);

    printf("\n=== TCP Summary ===\n");
    printf("Total TCP bytes received: %lld\n", @tcp_total_bytes);
    printf("Total TCP recvs: %lld\n", @tcp_recv_count);
    printf("TCP sends: "); print(@tcp_send_count);

    printf("\nTCP bytes per recv:\n"); print(@tcp_bytes_hist);
    printf("\nTCP recv latency (us):\n"); print(@tcp_lat_us);

    clear(@submit_count);
    clear(@complete_count);
    clear(@submit_by_op);
    clear(@complete_res_hist);
    clear(@tcp_recv_start);
    clear(@tcp_bytes_hist);
    clear(@tcp_lat_us);
    clear(@tcp_total_bytes);
    clear(@tcp_recv_count);
    clear(@tcp_send_count);
}
