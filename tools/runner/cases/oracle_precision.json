{
  "fixtures": [
    {
      "name": "main",
      "copy": "COPY (SELECT CAST(d AS DECIMAL(38,2)) AS d FROM (VALUES ('12345678901234567890123456789.01'), ('12345678901234567890123456789.02'), ('-12345678901234567890123456789.00')) t(d)) TO '{path}' (FORMAT PARQUET)"
    },
    {
      "name": "nullable_flba",
      "copy": "COPY (SELECT CAST(d AS DECIMAL(20,2)) AS price FROM (VALUES ('100.00'), (NULL), ('200.50'), (NULL), ('50.25')) t(d)) TO '{path}' (FORMAT PARQUET)"
    }
  ],
  "schema_order": [
    "d"
  ],
  "cases": [
    {
      "id": "precision:write-all"
    },
    {
      "id": "precision:filter",
      "filter": "d > 0",
      "where": "d > 0"
    },
    {
      "id": "precision:aggregate",
      "kind": "agg",
      "aggregate": "sum(d) AS s, min(d) AS lo, max(d) AS hi",
      "duck": "sum(d), min(d), max(d)"
    },
    {
      "id": "precision:mean",
      "kind": "agg",
      "aggregate": "avg(d) AS a",
      "duck": "sum(d), count(d)",
      "mean_scale": 2
    },
    {
      "id": "precision:group",
      "kind": "groupby",
      "group_by": "d",
      "aggregate": "count(*) AS n",
      "duck": "SELECT d, count(*) AS n FROM '{path}' GROUP BY d"
    },
    {
      "id": "precision:nullable-flba-skips-null-values",
      "kind": "agg",
      "fixture": "nullable_flba",
      "aggregate": "sum(price) AS s, count(price) AS c, min(price) AS lo, max(price) AS hi",
      "duck": "sum(price), count(price), min(price), max(price)"
    }
  ]
}
